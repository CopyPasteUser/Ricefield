[Desktop Entry]
Type=Application
Name=RiceExplorer
GenericName=File Manager
Comment=Customizable Rust file explorer for RiceBowl
Exec=rice-explorer %F
Icon=rice-explorer
Terminal=false
Categories=System;FileManager;
Keywords=Files;Folders;Explorer;RiceBowl;
MimeType=inode/directory;
StartupNotify=true
StartupWMClass=RiceExplorer
